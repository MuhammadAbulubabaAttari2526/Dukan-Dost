# Public Firebase web configuration only. Never place Admin SDK credentials in VITE_ variables.
VITE_FIREBASE_API_KEY=your_web_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_web_app_id
# Optional: expose the explicitly labeled session-only demo when Firebase is configured.
VITE_ENABLE_DEMO=true
# Local emulator development only; must remain false in deployed environments.
VITE_USE_FIREBASE_EMULATORS=false
